<?xml version="1.0" encoding="utf-8"?>
<!--
  Yalnizca `kontrol` derleme TIPINDE birlestirilir (bkz. app/build.gradle.kts).

  Windows -> Android YONUNDE uzak kontrol. Bu manifest main'e bilerek
  konulmamistir: Google Play Protect, yandan yükleme yapilan ve
  AccessibilityService BILDIREN uygulamalari tamamen engelliyor.

  uretim:  gradlew assembleKontrolRelease
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
             Sistem bu servisi BIND_ACCESSIBILITY_SERVICE izniyle baglar;
             kullanici Ayarlar -> Erisilebilirlik'ten acmalidir.
        -->
        <service
            android:name=".control.RemoteControlService"
            android:label="@string/accessibility_service_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
